{
  "name": "@napi-rs/system-ocr",
  "version": "1.0.2",
  "description": "OCR via system provided API",
  "keywords": [
    "N-API",
    "NAPI",
    "Rust",
    "media-ocr",
    "napi-rs",
    "node-addon",
    "node-addon-api",
    "ocr",
    "visionkit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Brooooooklyn/system-ocr.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Brooooooklyn"
  },
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "main": "index.js",
  "browser": "browser.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:source format:rs",
    "format:source": "oxfmt",
    "format:rs": "cargo fmt",
    "lint": "oxlint",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "version": "napi version"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.0.0",
    "@napi-rs/cli": "3.6.2",
    "@oxc-node/core": "^0.1.0",
    "@types/node": "^24.1.0",
    "ava": "^8.0.0",
    "chalk": "^5.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.8.0",
    "typescript": "^6.0.0"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json|toml)": [
      "oxfmt"
    ]
  },
  "napi": {
    "binaryName": "system-ocr",
    "constEnum": false,
    "packageName": "@napi-rs/system-ocr",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "ava": {
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ],
    "timeout": "2m",
    "workerThreads": false
  },
  "engines": {
    "node": ">= 10"
  },
  "packageManager": "pnpm@11.1.3"
}
